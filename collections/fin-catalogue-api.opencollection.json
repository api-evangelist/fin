{
  "opencollection": "1.0.0",
  "info": {
    "name": "Fin.com Authentication Catalogue API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Catalogue",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Industries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://sandbox.api.fin.com/v1/industries",
            "params": [
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of items to return per page"
              },
              {
                "name": "current_page",
                "value": "",
                "type": "query",
                "description": "The page number to retrieve"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve a list of available industries"
        },
        {
